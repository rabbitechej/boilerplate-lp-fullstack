# Portas publicadas no host
APP_PORT=8080
API_PORT=5000

# Gere com: openssl rand -base64 48
JWT_SECRET=substitua-por-um-segredo-longo-e-aleatorio
JWT_ISSUER=boilerplate-api
JWT_AUDIENCE=boilerplate-admin

# Administrador inicial (usado por admin:create:prod)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Necessárias para upload de imagens
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Modulo de blog/conteudos: false desliga nos dois lados (API e frontend).
# Como o frontend recebe por build-arg, mudar exige `docker compose build frontend`.
ENABLE_BLOG=true

# Web3Forms (opcional): key pública embutida no build do frontend.
# Como é build-arg, mudar exige `docker compose build frontend` de novo.
VITE_WEB3FORMS_ACCESS_KEY=
