# Servidor
PORT=5000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=0

# Logs estruturados
# LOG_LEVEL: debug | info | warn | error | silent
#   padrao: debug fora de producao, info em producao, silent nos testes.
# LOG_FORMAT: json (uma linha por evento, para agregadores) | pretty (terminal)
#   padrao: json em producao, pretty fora dela.
# LOG_LEVEL=debug
# LOG_FORMAT=pretty

# Modulo de blog/conteudos (rotas de posts, publicas e do painel).
# false desmonta as rotas; o model e os dados no banco ficam intactos.
# Precisa casar com VITE_ENABLE_BLOG do frontend.
# ENABLE_BLOG=true

# Swagger UI em /api/docs. Padrao: ligado fora de producao, desligado em
# producao. Use true para expor mesmo em producao (de preferencia atras de
# rede/proxy restrito).
# ENABLE_API_DOCS=false

# MongoDB
MONGODB_URI=mongodb+srv://usuario:senha@cluster/banco

# Autenticacao
JWT_SECRET=substitua-por-um-segredo-longo-e-aleatorio
JWT_ISSUER=boilerplate-api
JWT_AUDIENCE=boilerplate-admin
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
SESSION_IDLE_TTL_MINUTES=60
AUTH_COOKIE_SECURE=false

# Criacao inicial de administrador (usado apenas por npm run admin:create)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudinary (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Keep-alive self-ping (plano free do Render): GET periodico na URL publica /ready
# enquanto o processo esta acordado. Em production liga sozinho; em local fica
# desligado. Force com KEEP_ALIVE_SELF_PING=true (e uma URL publica).
# No Render, RENDER_EXTERNAL_URL ja e injetado automaticamente.
# KEEP_ALIVE_SELF_PING=false
# KEEP_ALIVE_URL=https://sua-api.onrender.com
# KEEP_ALIVE_INTERVAL_MS=240000

# Sentry (opcional — monitoramento de erros em produção)
# SENTRY_DSN=https://...@o....ingest.sentry.io/...
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1
