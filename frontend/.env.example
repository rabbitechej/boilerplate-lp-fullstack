VITE_API_URL=http://localhost:5000/api/v1

# Modulo de blog/conteudos. Deixe em branco (ou true) para manter ligado.
# Precisa casar com ENABLE_BLOG do backend — desligar so de um lado deixa link
# levando para 404 ou tela pedindo dado que a API nao serve mais.
# VITE_ENABLE_BLOG=true

# Sentry (opcional — embutido no build; configure antes de npm run build)
# VITE_SENTRY_DSN=https://...@o....ingest.sentry.io/...
# VITE_SENTRY_ENVIRONMENT=production
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Web3Forms (opcional — notificacao por e-mail do formulario de contato).
# A key e publica por design: o plano free so aceita submit no browser e o Vite
# embute VITE_* no bundle. Proteja com domain lock + rate limit no painel
# (https://web3forms.com). Sem ela o formulario continua funcionando: o backend
# salva a mensagem e so o e-mail deixa de sair.
# VITE_WEB3FORMS_ACCESS_KEY=
